# Copier ce fichier en .env puis le remplir. Ne JAMAIS commiter .env.

# Accès au réseau Sepolia (Alchemy ou Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/VOTRE_CLE
# Clé privée d'un compte RÉSERVÉ AUX TESTS (jamais votre compte principal)
PRIVATE_KEY=
# Vérification du code source sur Etherscan
ETHERSCAN_API_KEY=

# Chainlink VRF v2.5 (Sepolia)
# ID de VOTRE souscription, créée sur https://vrf.chain.link (voir docs/deploiement-sepolia.md)
VRF_SUBSCRIPTION_ID=
# Valeurs officielles (docs.chain.link/vrf/v2-5/supported-networks, relevées le 02/11/2026).
# Facultatives : si vides, celles de scripts/lib/networkConfig.js sont utilisées.
VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae

# Optionnel
REPORT_GAS=false
COINMARKETCAP_API_KEY=
# Mettre 1 seulement si binaries.soliditylang.org est inaccessible (réseau filtré)
SOLC_LOCAL=

# Serveur (comptes) : npm start
ADMIN_EMAIL=
ADMIN_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=blocklucky
# Interface (Next.js) : 11155111 (Sepolia) ou 31337 (local)
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Envoi de mails (facultatif mais conseillé en production) : à la première connexion, l'habitant reçoit un lien
# de confirmation et choisit son mot de passe en l'ouvrant. Sans SMTP_HOST, il le choisit directement (démo).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Adresse publique du site, utilisée dans le lien du mail : obligatoire avec SMTP_HOST (ex. https://block.axionstudio.fr)
SITE_URL=

# Design personnalisé par IA (espace mairie) : clé de l'API Gemini (Google AI Studio). Sans clé, la fonction
# est simplement désactivée. Modèle facultatif (défaut : gemini-3.8-flash).
GEMINI_API_KEY=
GEMINI_MODEL=
# Délai maximal d'attente de Gemini, en millisecondes (défaut : 45000)
GEMINI_TIMEOUT_MS=
